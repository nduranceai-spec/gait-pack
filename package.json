{
  "name": "gait-kinetic-x",
  "version": "1.0.0",
  "private": true,
  "description": "GAIT Kinetic X — High-performance Biomechanics & Motion Capture Platform",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"python scripts/dev_backend.py\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix client run preview",
    "dev:hardware": "python run.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
