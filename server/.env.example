# ==============================================================================
# GAIT Kinetic X - Server Environment Configuration
# ==============================================================================

# Local Development Server Binding
HOST=127.0.0.1
PORT=8765

# Maximum request body size in bytes (Vercel serverless request body limit is ~4.5MB)
MAX_BODY_BYTES=4000000

# Hardware mode (1 for local USB cameras / OpenCV, 0 for headless / serverless)
GAIT_HARDWARE_MODE=0

# Session data storage path
GAIT_DATA_DIR=/tmp/gait-data
