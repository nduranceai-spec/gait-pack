# ==============================================================================
# GAIT Kinetic X - Client Environment Configuration
# ==============================================================================

# API Base URL
# Leave empty on Vercel so all requests use relative paths (/api/...) on the same domain.
# For local decoupled dev, set to http://127.0.0.1:8765
VITE_API_URL=

# Mode override: 'browser' (client-side MediaPipe WASM) or 'server' (local hardware)
VITE_POSE_MODE=browser
