{
  "version": 2,
  "builds": [
    {
      "src": "src/web_server.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/web_server.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ],
  "env": {
    "GAIT_DATA_DIR": "/tmp/gait-data",
    "GAIT_ALLOWED_ORIGINS": ""
  }
}
