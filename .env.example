# ==============================================================================
# GAIT Kinetic X - Environment Variables Template
# ==============================================================================

# Frontend (Vite)
# Leave empty on Vercel so all requests use relative paths (/api/...) on the same domain.
VITE_API_URL=

# Mode override: 'browser' (client-side MediaPipe WASM) or 'server' (local hardware)
# On Vercel, auto-detection automatically defaults to 'browser'.
VITE_POSE_MODE=browser

# Backend Serverless Configuration (FastAPI)
# Maximum request body size in bytes (Vercel serverless request body limit is ~4.5MB)
MAX_BODY_BYTES=4000000

# Local Development Server Only
HOST=127.0.0.1
PORT=8765
